#!/bin/sh
# Fast commit checks: types and changed-file lint, plus clippy for Rust changes.
# Run relevant tests during development; CI runs the complete suite.
set -e
# Prefer rustup's toolchain: on some Macs Homebrew's rustc comes first on PATH and is broken.
if [ -d "$HOME/.cargo/bin" ]; then PATH="$HOME/.cargo/bin:$PATH"; fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

code=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|mts|cts|js|mjs|cjs)$' || true)
if [ -n "$code" ]; then
  # The whole project's types, incrementally: a few seconds once warm.
  pnpm -s exec tsc --noEmit -p . --incremental --tsBuildInfoFile node_modules/.cache/gaia.tsbuildinfo
  printf '%s\n' "$code" | xargs pnpm -s exec eslint
fi

if printf '%s\n' "$staged" | grep -qE '^(engine/|Cargo\.(toml|lock)$)'; then
  cargo clippy --all-targets --quiet -- -D warnings
fi
