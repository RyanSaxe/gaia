{
  "name": "gaia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm engine && pnpm --filter @gaia/app dev",
    "shots": "pnpm --filter @gaia/app exec install-electron && tsx tools/shots.ts",
    "brand": "tsx tools/brand.ts",
    "sound": "tsx tools/sound.ts",
    "lab:html": "tsx tools/lab-html.ts",
    "lab:serve": "tsx tools/lab-serve.ts",
    "readme-shots": "tsx tools/readme-shots.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "tsc --noEmit -p . && eslint . && vitest run",
    "prepare": "git config core.hooksPath .githooks",
    "engine": "tsx tools/cargo.ts build -p gaia-engine",
    "graph-snapshot": "tsx tools/graph-snapshot.ts",
    "print-world-requests": "tsx tools/print-world-requests.ts",
    "openrouter-stand-in": "tsx tools/openrouter-stand-in.ts",
    "jev-world": "tsx tools/jev-world.ts",
    "proving": "tsx tools/proving.ts",
    "showcase": "tsx tools/showcase.ts",
    "probe": "tsx tools/probe.ts",
    "bench": "tsx tools/bench.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gaia/kinds": "workspace:*",
    "@gaia/primitives": "workspace:*",
    "@gaia/schema": "workspace:*",
    "@gaia/world": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
